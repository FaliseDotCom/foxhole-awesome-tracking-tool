# The repository root is the web root: source lives in dot folders (.app, .api), the built
# app (index.html, _app/) and assets/ are served directly.

# original source material
.org/

# PHP dependencies and runtime output; run composer install in .api instead
.api/vendor/
.api/cache/
.api/logs/
.api/data/

# editor and OS files
.idea/
.DS_Store
Thumbs.db

# log files
*.log
