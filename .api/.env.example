# Server settings for F.A.T.T. Copy this file to .api/.env on the server (by FTP; the deploy
# never uploads or overwrites .env) and fill it in. KEY=value, # for comments.

# Visitor statistics: the Matomo address and the site id of F.A.T.T. in it. Leave them empty
# or remove them to turn tracking off.
MATOMO_URL=https://matomo.fali.se/
MATOMO_SITE_ID=
