# Server settings for F.A.T.T. Copy this file to .api/.env on the server and fill it in. It is
# not in the repository. KEY=value, # for comments.

# Visitor statistics: the Matomo address and the site id of F.A.T.T. in it. Leave them empty
# or remove them to turn tracking off.
MATOMO_URL=https://matomo.example.com/
MATOMO_SITE_ID=
