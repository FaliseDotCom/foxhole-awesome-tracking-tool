# The repository root is the web root. Source, configuration, and runtime data live in dot
# folders (.app, .api, .docs, ...) and are never served. Keep .api/router.php in step with
# these rules; it does the same for the PHP development server.

Options -Indexes

<IfModule mod_headers.c>
  # stylesheets and the app page keep their names between deploys, so browsers must check for
  # a new version on every load (a cheap 304 when nothing changed); the scripts in _app/ have
  # new names on every build and can be cached normally
  <FilesMatch "\.(css|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

RewriteEngine On

# /api/<route> is handled by the PHP API; END stops the dot-folder rule below from
# blocking the rewritten request
RewriteRule ^api(?:/(.*))?$ .api/index.php?route=$1 [END,QSA]

# hide every dot file and dot folder, except .well-known for certificates
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [R=404,L]

# hide repository files
RewriteRule ^(README\.md|LICENSE)$ - [R=404,L]

# single page app: anything that is not a file is served by index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
